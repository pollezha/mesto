# Переменные окружения — docs/package/07-*.md («Инфраструктура» → «Переменные окружения»).
# Локально: скопировать в .env и заполнить.
# На сервере SMTP_* и MAIL_* (кроме необязательной SMTP_SECURE) берутся из секретов репозитория GitHub:
# деплой сам пишет файл окружения при каждом выкате (Н71), руками на VPS его не править.
# Секреты с теми же именами: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_SECURE, MAIL_FROM, MAIL_TO.
# Значение не должно содержать одинарную кавычку и перевод строки.

# canonical, hreflang, sitemap
NUXT_PUBLIC_SITE_URL=https://mesto.studio

# SMTP отправителя
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=

# Отправитель и получатель писем с заявками
MAIL_FROM=
MAIL_TO=hello@mesto.studio

# Cookie-баннер, счётчики и ссылка «Настройки cookie»: действует, если задан хотя бы один ID.
# Ставить true, когда есть ID счётчиков (Д3).
NUXT_PUBLIC_ANALYTICS_ENABLED=false
NUXT_PUBLIC_GA_ID=
NUXT_PUBLIC_YM_ID=
