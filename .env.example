# Переменные окружения — docs/package/07-*.md («Инфраструктура» → «Переменные окружения»).
# Скопировать в .env и заполнить. Секреты — только в .env на сервере и в секретах CI.

# canonical, hreflang, sitemap
NUXT_PUBLIC_SITE_URL=https://mesto.studio

# Telegram Bot API: бот и чат для заявок
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP отправителя
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=

# Отправитель и получатель писем с заявками
MAIL_FROM=
MAIL_TO=hello@mesto.studio

# Cookie-баннер, счётчики и ссылка «Настройки cookie»: действует, если задан хотя бы один ID.
# Ставить true, когда есть ID счётчиков (Д3).
NUXT_PUBLIC_ANALYTICS_ENABLED=false
NUXT_PUBLIC_GA_ID=
NUXT_PUBLIC_YM_ID=
