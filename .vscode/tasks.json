{
  // Terminal → Run Task. Команды — из package.json (см. CLAUDE.md → «Команды»).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "build (MESTO_KIT=1)",
      "type": "npm",
      "script": "build",
      "options": { "env": { "MESTO_KIT": "1" } },
      "problemMatcher": []
    },
    {
      "label": "check",
      "type": "npm",
      "script": "check",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "test:e2e",
      "type": "npm",
      "script": "test:e2e",
      "problemMatcher": []
    },
    {
      // Сайт в Docker для телефона в том же Wi-Fi: http://<IP компьютера>:8080 (docker-compose.local.yml)
      "label": "local: Docker для Wi-Fi (up)",
      "type": "shell",
      "command": "docker compose -f docker-compose.local.yml up -d --build",
      "problemMatcher": []
    },
    {
      "label": "local: Docker для Wi-Fi (down)",
      "type": "shell",
      "command": "docker compose -f docker-compose.local.yml down",
      "problemMatcher": []
    }
  ]
}
